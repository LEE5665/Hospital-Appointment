<UserControl x:Class="Project.Views.PatientHistoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="AcceptsReturn" Value="True"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="MaxHeight" Value="200"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="MaxHeight" Value="240"/>
   <Setter Property="MinHeight" Value="65"/>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="4,8">
  <DockPanel><Button DockPanel.Dock="Right" Content="기록 새로고침" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"/>
   <TextBlock Text="{Binding PatientLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
  </DockPanel>
  <TextBlock Text="날짜·담당 의사 제한 없이 모든 방문을 조회합니다. 방문을 선택해 내용을 확인하세요." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6"/>
  <DataGrid ItemsSource="{Binding Visits}" SelectedItem="{Binding SelectedVisit}" IsEnabled="{Binding CanRefresh}" CanUserSortColumns="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="방문일시" Binding="{Binding RegisteredAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
    <DataGridTextColumn Header="의사" Binding="{Binding DoctorName}" Width="80"/>
    <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="65"/>
    <DataGridTextColumn Header="방문 사유" Binding="{Binding Reason}" Width="180"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel><Button Content="이전" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/><Button Content="다음" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="6"/></WrapPanel>
  <StackPanel>
   <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Record}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
  <TextBlock Text="{Binding SelectedVisit.Times}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6"/>
  <TextBlock Text="방문 사유" FontWeight="SemiBold"/><TextBox Text="{Binding Record.Reason, Mode=OneWay}"/>
  <TextBlock Text="S · 환자 호소" FontWeight="SemiBold"/><TextBox Text="{Binding Record.Subjective, Mode=OneWay}"/>
  <TextBlock Text="O · 진찰·검사 소견" FontWeight="SemiBold"/><TextBox Text="{Binding Record.Objective, Mode=OneWay}"/>
  <TextBlock Text="A · 평가" FontWeight="SemiBold"/><TextBox Text="{Binding Record.Assessment, Mode=OneWay}"/>
  <TextBlock Text="P · 계획" FontWeight="SemiBold"/><TextBox Text="{Binding Record.Plan, Mode=OneWay}"/>
  <TextBlock Text="진단" FontWeight="SemiBold" Margin="0,6"/>
  <DataGrid ItemsSource="{Binding Record.Diagnoses}"><DataGrid.Columns>
   <DataGridTextColumn Header="구분" Binding="{Binding KindLabel}" Width="65"/>
   <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="80"/>
   <DataGridTextColumn Header="진단명" Binding="{Binding Name}" Width="*"/>
  </DataGrid.Columns></DataGrid>
  <TextBlock Text="처방" FontWeight="SemiBold" Margin="0,6"/>
  <DataGrid ItemsSource="{Binding Record.Prescriptions}"><DataGrid.Columns>
   <DataGridTextColumn Header="약품" Binding="{Binding Name}" Width="180"/>
   <DataGridTextColumn Header="투여 방법" Binding="{Binding ScheduleLabel}" Width="180"/>
   <DataGridTextColumn Header="용법" Binding="{Binding Instructions}" Width="180"/>
  </DataGrid.Columns></DataGrid>
  </StackPanel>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Background="#E0E7FF" Padding="8" Margin="0,8"/>
 </StackPanel>
</UserControl>
