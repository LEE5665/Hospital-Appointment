<UserControl x:Class="Project.Views.ClinicalOrdersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,0,6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="34"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
 <DockPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Background="#E0E7FF" Padding="10" Margin="0,8,0,0"/>
  <Grid IsEnabled="{Binding IsIdle}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <WrapPanel IsEnabled="{Binding CanSelect}">
     <StackPanel Orientation="Horizontal" Visibility="{Binding IsBoard, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="요청일" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <DatePicker SelectedDate="{Binding SelectedDate}" Width="125" ToolTip="날짜를 비우면 모든 날짜를 조회합니다."/>
     </StackPanel>
     <ComboBox SelectedIndex="{Binding TypeIndex}" Width="90" Margin="4"><ComboBoxItem Content="전체 유형"/><ComboBoxItem Content="검사"/><ComboBoxItem Content="처치"/></ComboBox>
     <ComboBox SelectedIndex="{Binding StatusIndex}" Width="105" Margin="4"><ComboBoxItem Content="전체 상태"/><ComboBoxItem Content="요청 + 수행 중"/><ComboBoxItem Content="요청"/><ComboBoxItem Content="수행 중"/><ComboBoxItem Content="완료"/><ComboBoxItem Content="취소"/></ComboBox>
     <Button Content="조회 / 새로고침" Command="{Binding RefreshCommand}"/>
    </WrapPanel>
    <WrapPanel IsEnabled="{Binding CanSelect}" Margin="0,4,0,8">
     <CheckBox Content="내가 요청한 항목" IsChecked="{Binding MineOnly}" IsEnabled="{Binding IsDoctor}" Margin="0,0,12,0"/>
     <CheckBox Content="완료 · 의사 미확인" IsChecked="{Binding UnreviewedOnly}" Margin="0,0,12,0"/>
     <CheckBox Content="이 환자의 과거 기록 포함" IsChecked="{Binding IncludePatientHistory}" Visibility="{Binding IsEmbedded, Converter={StaticResource BoolVisibility}}"/>
    </WrapPanel>
    <TextBlock Text="날짜를 비우면 이전 날짜의 미완료 요청도 표시합니다." Foreground="#64748B" Visibility="{Binding IsBoard, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
   </StackPanel>
   <Expander Grid.Row="1" Header="새 검사·처치 요청" IsExpanded="False" Visibility="{Binding IsEmbedded, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
    <StackPanel IsEnabled="{Binding CanCreate}" Margin="8">
     <TextBlock Text="{Binding ContextLabel}" FontWeight="SemiBold"/>
     <TextBlock Text="분류" Margin="0,8,0,0"/>
     <ComboBox SelectedIndex="{Binding RequestTypeIndex}" Margin="0,5"><ComboBoxItem Content="검사"/><ComboBoxItem Content="처치"/></ComboBox>
     <TextBlock Text="검사·처치명" Margin="0,8,0,0"/>
     <TextBox Text="{Binding RequestName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" ToolTip="요청할 검사 또는 처치의 이름을 직접 입력하세요."/>
     <TextBlock Text="요청 사항" Margin="0,8,0,0"/>
     <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000" Height="65" VerticalScrollBarVisibility="Auto"/>
     <Button Content="요청 등록" Command="{Binding CreateCommand}" HorizontalAlignment="Right"/>
    </StackPanel>
   </Expander>
   <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsEnabled="{Binding CanSelect}" MinHeight="100" MaxHeight="260" CanUserSortColumns="False">
    <DataGrid.Columns>
     <DataGridTextColumn Header="요청일시" Binding="{Binding RequestedAt, StringFormat=MM-dd HH:mm}" Width="100"/>
     <DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="80"/>
     <DataGridTextColumn Header="종류" Binding="{Binding TypeLabel}" Width="45"/>
     <DataGridTextColumn Header="항목" Binding="{Binding ItemName}" Width="150"/>
     <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="65"/>
     <DataGridTextColumn Header="결과 확인" Binding="{Binding ReviewLabel}" Width="70"/>
     <DataGridTextColumn Header="요청 의사" Binding="{Binding RequestedByName}" Width="85"/>
     <DataGridTextColumn Header="수행자" Binding="{Binding PerformedByName}" Width="85"/>
    </DataGrid.Columns>
   </DataGrid>
   <WrapPanel Grid.Row="3"><Button Content="이전" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/><Button Content="다음" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8"/></WrapPanel>
    <StackPanel Grid.Row="4">
     <TextBlock Text="{Binding SelectedOrder.DetailTitle, TargetNullValue=요청을 선택하면 상세 기록이 표시됩니다.}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding SelectedOrder.Instructions}" TextWrapping="Wrap" Margin="0,5"/>
     <TextBlock Text="{Binding SelectedOrder.Timeline}" Foreground="#64748B" TextWrapping="Wrap"/>
     <TextBlock Text="검사 결과 / 처치 수행 내용" FontWeight="SemiBold" Margin="0,8,0,0"/>
     <TextBox Text="{Binding ResultText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsResultReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" Height="85" MaxLength="20000" VerticalScrollBarVisibility="Auto"/>
     <WrapPanel>
      <Button Content="수행 시작" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
      <Button Content="결과 저장 · 수행 완료" Command="{Binding CompleteCommand}" IsEnabled="{Binding CanComplete}"/>
      <Button Content="의사 결과 확인" Command="{Binding ReviewCommand}" IsEnabled="{Binding CanReview}"/>
      <Button Content="해당 진료 열기" Command="{Binding OpenEncounterCommand}"/>
      <Button Content="입력 취소" Command="{Binding DiscardDraftCommand}"/>
     </WrapPanel>
     <DockPanel IsEnabled="{Binding CanCancel}">
      <Button DockPanel.Dock="Right" Content="요청 취소" Command="{Binding CancelCommand}"/>
      <TextBox Text="{Binding CancellationText, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" ToolTip="요청 취소 사유"/>
     </DockPanel>
    </StackPanel>
  </Grid>
 </DockPanel>
 </ScrollViewer>
</UserControl>
