<UserControl x:Class="Project.Views.BillingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <DockPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Background="#E0E7FF" Padding="10" Margin="0,12,0,0"/>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
   <TextBlock Text="진료 완료일" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <DatePicker SelectedDate="{Binding SelectedDate}" Width="130"/>
   <Button Content="조회 / 새로고침" Command="{Binding RefreshCommand}" Padding="12,6" Margin="8,0"/>
  </StackPanel>
  <Grid IsEnabled="{Binding IsIdle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
    IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="36">
    <DataGrid.Columns>
     <DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="*"/>
     <DataGridTextColumn Header="완료시각" Binding="{Binding CompletedAt, StringFormat=HH:mm}" Width="70"/>
     <DataGridTextColumn Header="담당 의사" Binding="{Binding DoctorName}" Width="85"/>
     <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="75"/>
     <DataGridTextColumn Header="금액" Binding="{Binding AmountLabel}" Width="100"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Column="1" Background="White" Padding="18" Margin="12,0,0,0">
    <StackPanel>
     <TextBlock Text="{Binding SelectedRow.PatientName, TargetNullValue=환자를 선택하세요.}" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding SelectedRow.ChartNumber}" Foreground="#64748B" Margin="0,5,0,16"/>
     <StackPanel IsEnabled="{Binding CanPay}">
      <TextBlock Text="수납 금액 (원)"/>
      <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="8" Margin="0,6,0,14"/>
      <TextBlock Text="결제수단"/>
      <ComboBox SelectedIndex="{Binding MethodIndex}" Margin="0,6,0,16" Padding="6">
       <ComboBoxItem Content="현금"/><ComboBoxItem Content="카드"/>
      </ComboBox>
      <Button Content="수납 처리" Command="{Binding PayCommand}" Padding="12,10" Background="#2563EB" Foreground="White"/>
     </StackPanel>
     <TextBlock Text="{Binding SelectedRow.StatusLabel}" FontWeight="SemiBold" Margin="0,18,0,6"/>
     <TextBlock Text="{Binding SelectedRow.MethodLabel}"/>
     <TextBlock Text="{Binding SelectedRow.ReceivedByName}" Margin="0,6"/>
     <TextBlock Text="{Binding SelectedRow.PaidAt, StringFormat=yyyy-MM-dd HH:mm}"/>
    </StackPanel>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
