<UserControl x:Class="Project.Views.EncounterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded"> <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style x:Key="SoapInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="MinHeight" Value="90"/>
   <Setter Property="MaxHeight" Value="220"/><Setter Property="MaxLength" Value="20000"/>
   <Setter Property="IsReadOnly" Value="True"/>
   <Style.Triggers><DataTrigger Binding="{Binding CanWrite}" Value="True"><Setter Property="IsReadOnly" Value="False"/></DataTrigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/></Style>
 </UserControl.Resources><DockPanel><Border DockPanel.Dock="Bottom" Background="#E0E7FF" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border><Grid IsEnabled="{Binding IsIdle}">
     <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <WrapPanel Margin="0,0,0,8"><DatePicker SelectedDate="{Binding SelectedDate}" Width="130" VerticalAlignment="Center"/><ComboBox SelectedIndex="{Binding FilterIndex}" Width="140" Margin="6,0" VerticalAlignment="Center"><ComboBoxItem Content="대기 + 진료 중"/><ComboBoxItem Content="진료 대기"/><ComboBoxItem Content="진료 중"/><ComboBoxItem Content="완료 기록"/></ComboBox><Button Content="조회 / 새로고침" Command="{Binding RefreshCommand}"/></WrapPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,10"><CheckBox Content="내 담당 + 미지정 환자" IsChecked="{Binding MineOnly}" IsEnabled="{Binding IsDoctor}"/><TextBlock Text="먼저 접수한 순서 · 조건 변경 후 조회를 눌러 주세요." Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
       <DataGrid Grid.Row="2" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedQueueItem}" CanUserSortColumns="False" EnableRowVirtualization="True" IsEnabled="{Binding IsQueueSelectionEnabled}"><DataGrid.Columns><DataGridTextColumn Header="순서" Binding="{Binding QueuePosition}" Width="45"/><DataGridTextColumn Header="접수" Binding="{Binding RegisteredAt, StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="대기" Binding="{Binding WaitingTime}" Width="55"/><DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="90"/><DataGridTextColumn Header="의사" Binding="{Binding DoctorName}" Width="75"/><DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="85"/></DataGrid.Columns></DataGrid>
       <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding PageLabel}"/><StackPanel Orientation="Horizontal"><Button Content="이전" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/><Button Content="다음" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/></StackPanel></StackPanel>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{Binding SelectedEncounter.PatientName, TargetNullValue=환자를 선택하세요}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding SelectedEncounter.ChartNumber}" Foreground="#64748B"/>
        <TextBlock Text="접수 시 방문 사유" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="{Binding SelectedEncounter.Reason}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Button Content="진료 시작 · 담당 확정" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
        <TextBlock Text="SOAP 진료기록" FontWeight="Bold" Margin="0,12,0,4"/>
        <TextBlock Text="작성 중에는 일부 항목만 저장할 수 있습니다. 완료한 기록은 조회만 가능합니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
       </StackPanel>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel>
         <Expander Header="이 환자의 전체 진료 기록" Margin="0,0,0,12">
          <ContentControl Content="{Binding History}" HorizontalContentAlignment="Stretch"/>
         </Expander>
         <Expander Header="검사 · 처치 요청 및 결과" Margin="0,0,0,12">
          <ContentControl Content="{Binding Orders}" HorizontalContentAlignment="Stretch"/>
         </Expander>
         <DockPanel><Button DockPanel.Dock="Right" Content="방문 사유 가져오기" Command="{Binding ImportReasonCommand}" IsEnabled="{Binding CanWrite}"/><TextBlock Text="S · 환자 호소" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
         <TextBlock Text="환자가 말하는 증상, 발생 시점, 경과 등" Foreground="#64748B"/>
         <TextBox Text="{Binding Subjective, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SoapInput}"/>
         <TextBlock Text="O · 진찰·검사 소견" FontWeight="SemiBold"/>
         <TextBlock Text="진찰에서 확인한 사실, 활력징후, 검사 결과 등" Foreground="#64748B"/>
         <TextBox Text="{Binding Objective, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SoapInput}"/>
         <TextBlock Text="A · 평가" FontWeight="SemiBold"/>
         <TextBlock Text="의사의 판단, 의심되는 질환과 진단 근거 등" Foreground="#64748B"/>
         <TextBox Text="{Binding Assessment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SoapInput}"/>
         <TextBlock Text="진단명 · KCD" FontWeight="SemiBold"/>
         <StackPanel IsEnabled="{Binding CanWrite}">
          <DockPanel>
           <Button DockPanel.Dock="Right" Content="검색" Command="{Binding SearchDiagnosesCommand}"/>
           <TextBox Text="{Binding DiagnosisQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" ToolTip="진단명, 별칭, 코드로 검색">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchDiagnosesCommand}"/></TextBox.InputBindings>
           </TextBox>
          </DockPanel>
          <TextBlock Text="{Binding DiagnosisSearchMessage}" Foreground="#64748B" TextWrapping="Wrap"/>
          <DockPanel Margin="0,6,0,8">
           <Button DockPanel.Dock="Right" Content="추가" Command="{Binding AddDiagnosisCommand}"/>
           <ComboBox ItemsSource="{Binding DiagnosisResults}" SelectedItem="{Binding SelectedDiagnosisResult}" DisplayMemberPath="Label" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" MaxDropDownHeight="260"/>
          </DockPanel>
         </StackPanel>
         <DataGrid ItemsSource="{Binding Diagnoses}" SelectedItem="{Binding SelectedDiagnosis}" MinHeight="85" MaxHeight="200" Margin="0,0,0,4" SelectionUnit="FullRow">
          <DataGrid.Columns>
           <DataGridTextColumn Header="구분" Binding="{Binding KindLabel}" Width="65"/>
           <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="75"/>
           <DataGridTextColumn Header="진단명" Binding="{Binding Name}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
         <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanWrite}" Margin="0,0,0,12">
          <Button Content="선택 항목을 주진단으로" Command="{Binding SetPrincipalDiagnosisCommand}"/>
          <Button Content="선택 항목 삭제" Command="{Binding RemoveDiagnosisCommand}"/>
         </StackPanel>
         <TextBlock Text="P · 계획" FontWeight="SemiBold"/>
         <TextBlock Text="검사, 치료, 처방, 추적 관찰 계획 등" Foreground="#64748B"/>
         <TextBox Text="{Binding Plan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SoapInput}"/>
         <TextBlock Text="약 처방" FontWeight="Bold" Margin="0,12,0,4"/>
         <TextBlock Text="약품을 선택하고 투여 방법을 입력하세요. 처방은 별도로 저장합니다." TextWrapping="Wrap" Foreground="#64748B"/>
         <StackPanel IsEnabled="{Binding CanWrite}">
          <DockPanel><Button DockPanel.Dock="Right" Content="약품 검색" Command="{Binding SearchMedicationsCommand}"/>
           <TextBox Text="{Binding MedicationQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="100">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchMedicationsCommand}"/></TextBox.InputBindings>
           </TextBox>
          </DockPanel>
          <TextBlock Text="{Binding MedicationMessage}" TextWrapping="Wrap" Foreground="#64748B"/>
          <ComboBox ItemsSource="{Binding MedicationResults}" SelectedItem="{Binding SelectedMedication}" DisplayMemberPath="Label" Margin="0,8" MaxDropDownHeight="250"/>
          <TextBlock Text="{Binding SelectedMedication.Label}" TextWrapping="Wrap"/>
          <UniformGrid Columns="2">
           <StackPanel Margin="0,0,8,0"><TextBlock Text="1회 투여량"/><TextBox Text="{Binding PrescriptionDose, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/></StackPanel>
           <StackPanel><TextBlock Text="투여 단위 (정, 캡슐, mL 등)"/><TextBox Text="{Binding PrescriptionUnit, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/></StackPanel>
           <StackPanel Margin="0,0,8,0"><TextBlock Text="1일 투여 횟수"/><TextBox Text="{Binding PrescriptionFrequency, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/></StackPanel>
           <StackPanel><TextBlock Text="투여 일수"/><TextBox Text="{Binding PrescriptionDays, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/></StackPanel>
          </UniformGrid>
          <TextBlock Text="용법 · 투여경로 및 복용 시점"/><TextBox Text="{Binding PrescriptionInstructions, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
          <WrapPanel><Button Content="목록에 추가 / 수정 반영" Command="{Binding AddPrescriptionCommand}"/><Button Content="새 처방 / 입력 초기화" Command="{Binding NewPrescriptionCommand}"/></WrapPanel>
         </StackPanel>
         <DataGrid ItemsSource="{Binding Prescriptions}" SelectedItem="{Binding SelectedPrescription}" IsEnabled="{Binding CanSelectPrescription}" MinHeight="90" MaxHeight="240" Margin="0,8">
          <DataGrid.Columns>
           <DataGridTextColumn Header="약품명" Binding="{Binding Name}" Width="180"/>
           <DataGridTextColumn Header="제조사" Binding="{Binding Manufacturer}" Width="110"/>
           <DataGridTextColumn Header="투여 방법" Binding="{Binding ScheduleLabel}" Width="180"/>
           <DataGridTextColumn Header="용법" Binding="{Binding Instructions}" Width="180"/>
          </DataGrid.Columns>
         </DataGrid>
         <WrapPanel IsEnabled="{Binding CanWrite}"><Button Content="선택 처방 삭제" Command="{Binding RemovePrescriptionCommand}"/><Button Content="처방 저장" Command="{Binding SavePrescriptionsCommand}"/></WrapPanel>
        </StackPanel>
       </ScrollViewer>
       <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding CanWrite}"><Button Content="기록 저장" Command="{Binding SaveSoapCommand}"/><Button Content="진료 완료" Command="{Binding CompleteCommand}"/></StackPanel>
      </Grid>
     </Grid>
    </Grid></DockPanel></UserControl>
