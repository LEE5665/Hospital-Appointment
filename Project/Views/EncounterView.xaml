<UserControl x:Class="Project.Views.EncounterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded"> <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/></Style>
 </UserControl.Resources><DockPanel><Border DockPanel.Dock="Bottom" Background="#E0E7FF" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border><Grid IsEnabled="{Binding IsIdle}">
     <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <WrapPanel Margin="0,0,0,8"><DatePicker SelectedDate="{Binding SelectedDate}" Width="130" VerticalAlignment="Center"/><ComboBox SelectedIndex="{Binding FilterIndex}" Width="140" Margin="6,0" VerticalAlignment="Center"><ComboBoxItem Content="대기 + 진료 중"/><ComboBoxItem Content="진료 대기"/><ComboBoxItem Content="진료 중"/><ComboBoxItem Content="완료 기록"/></ComboBox><Button Content="조회 / 새로고침" Command="{Binding RefreshCommand}"/></WrapPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,10"><CheckBox Content="내 담당 + 미지정 환자" IsChecked="{Binding MineOnly}" IsEnabled="{Binding IsDoctor}"/><TextBlock Text="먼저 접수한 순서 · 조건 변경 후 조회를 눌러 주세요." Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
       <DataGrid Grid.Row="2" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedQueueItem}" CanUserSortColumns="False" EnableRowVirtualization="True" IsEnabled="{Binding IsQueueSelectionEnabled}"><DataGrid.Columns><DataGridTextColumn Header="순서" Binding="{Binding QueuePosition}" Width="45"/><DataGridTextColumn Header="접수" Binding="{Binding RegisteredAt, StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="대기" Binding="{Binding WaitingTime}" Width="55"/><DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="90"/><DataGridTextColumn Header="의사" Binding="{Binding DoctorName}" Width="75"/><DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="85"/></DataGrid.Columns></DataGrid>
       <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding PageLabel}"/><StackPanel Orientation="Horizontal"><Button Content="이전" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/><Button Content="다음" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/></StackPanel></StackPanel>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{Binding SelectedEncounter.PatientName, TargetNullValue=환자를 선택하세요}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding SelectedEncounter.ChartNumber}" Foreground="#64748B"/><TextBlock Text="{Binding SelectedEncounter.Reason}" TextWrapping="Wrap" Margin="0,10"/><Button Content="진료 시작 · 담당 확정" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/><TextBlock Text="진료기록" FontWeight="Bold" Margin="0,12,0,4"/></StackPanel>
       <TextBox Grid.Row="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="20000"><TextBox.Style><Style TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding CanWrite}" Value="True"><Setter Property="IsReadOnly" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
       <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding CanWrite}"><Button Content="기록 저장" Command="{Binding SaveNoteCommand}"/><Button Content="진료 완료" Command="{Binding CompleteCommand}"/></StackPanel>
      </Grid>
     </Grid>
    </Grid></DockPanel></UserControl>
