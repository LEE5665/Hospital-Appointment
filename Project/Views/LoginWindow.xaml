<Window x:Class="Project.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desk - Clinic Management 로그인"
        Width="440"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Border Padding="36">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 로고 & 타이틀 -->
                <RowDefinition Height="Auto"/>
                <!-- 입력 폼 -->
                <RowDefinition Height="*"/>
                <!-- 안내 푸터 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 로고 및 헤더 -->
            <StackPanel Grid.Row="0" Margin="0,10,0,30" HorizontalAlignment="Center">
                <TextBlock Text="Desk"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Clinic Management System"
                           Foreground="#94A3B8"
                           FontSize="14"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 입력 폼 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- 이메일 입력 -->
                <TextBlock Text="이메일 (아이디)"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox"
                         Height="42"
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#334155"
                         BorderThickness="1"
                         Text="doctor@hospital.com"
                         KeyDown="OnKeyDown"/>

                <!-- 비밀번호 입력 -->
                <TextBlock Text="비밀번호"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,18,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             FontSize="14"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Background="#1E293B"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             Password="password123"
                             KeyDown="OnKeyDown"/>

                <!-- 에러 메시지 표시 -->
                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#F87171"
                           FontSize="12"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- 로그인 버튼 -->
                <Button x:Name="LoginButton"
                        Content="로그인"
                        Height="46"
                        Margin="0,24,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnLoginClick"/>
            </StackPanel>

            <!-- 테스트 계정 안내 푸터 -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="[테스트 계정]"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="• 의사: doctor@hospital.com / password123"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="• 간호사: nurse@hospital.com / password123"
                               Foreground="#64748B"
                               FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
