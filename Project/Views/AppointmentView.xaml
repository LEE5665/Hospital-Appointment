<UserControl x:Class="Project.Views.AppointmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/></Style>
 </UserControl.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Padding="12" Background="#E0E7FF" Margin="0,12,0,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>
  <Grid IsEnabled="{Binding IsIdle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Border Background="White" Padding="16" CornerRadius="8"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="날짜별 예약 목록" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><DatePicker SelectedDate="{Binding ListDate}" Width="145" VerticalAlignment="Center"/><Button Content="조회" Command="{Binding LoadDateCommand}"/></StackPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}"><DataGrid.Columns>
     <DataGridTextColumn Header="시간" Binding="{Binding ScheduledAt, StringFormat=HH:mm}" Width="65"/><DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="90"/><DataGridTextColumn Header="의사" Binding="{Binding DoctorName}" Width="85"/><DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="90"/><DataGridTextColumn Header="예약 사유" Binding="{Binding Reason}" Width="150"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="방문 접수는 예약 당일에 가능합니다." Foreground="#64748B"/><StackPanel Orientation="Horizontal"><Button Content="예약 취소" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"/><Button Content="방문 접수" Command="{Binding CheckInCommand}" IsEnabled="{Binding CanCheckIn}"/></StackPanel></StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Background="White" Padding="16" CornerRadius="8"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="신규 예약" Command="{Binding NewBookingCommand}"/><TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
    <StackPanel IsEnabled="{Binding CanChoosePatient}">
    <TextBlock Text="환자 검색 · 이름 / 연락처 / 차트번호"/><DockPanel><Button DockPanel.Dock="Right" Content="검색" Command="{Binding SearchCommand}"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></DockPanel>
    <DataGrid ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" Height="140"><DataGrid.Columns><DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="생년월일" Binding="{Binding BirthDate, StringFormat=yyyy-MM-dd}" Width="100"/></DataGrid.Columns></DataGrid>
    </StackPanel>
    <TextBlock Text="{Binding EditorPatientName}" FontWeight="Bold" Margin="0,8,0,12"/>
    <TextBlock Text="목록에서 예약을 선택하면 수정할 수 있습니다. 접수 완료·취소 예약은 조회만 가능합니다." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <StackPanel IsEnabled="{Binding CanSaveBooking}">
    <TextBlock Text="예약 날짜"/><DatePicker SelectedDate="{Binding BookingDate}" Margin="0,6,0,12"/>
    <TextBlock Text="예약 시간 · 30분 단위"/><ComboBox ItemsSource="{Binding Times}" SelectedItem="{Binding BookingTime}" Padding="6" Margin="0,6,0,12"/>
    <TextBlock Text="담당 의사"/><ComboBox ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor}" DisplayMemberPath="Label" Padding="6" Margin="0,6,0,12"/>
    <TextBlock Text="예약 사유"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
    <Button Content="{Binding SaveLabel}" Command="{Binding BookCommand}" Background="#2563EB" Foreground="White"/>
    </StackPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </DockPanel>
</UserControl>
