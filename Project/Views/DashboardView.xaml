<UserControl x:Class="Project.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#334155"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Empty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,20"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                <StackPanel><TextBlock Text="오늘의 현황" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding TodayLabel}" Margin="0,6,0,0" Foreground="#64748B"/>
                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Margin="0,4,0,0" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="오늘 예약 · 건"/><TextBlock Text="{Binding AppointmentCount}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0" Foreground="#0F172A"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="진료 대기 · 명"/><TextBlock Text="{Binding WaitingCount}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0" Foreground="#B45309"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="진료 중 · 명"/><TextBlock Text="{Binding InProgressCount}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0" Foreground="#2563EB"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="진료 완료 · 건"/><TextBlock Text="{Binding CompletedCount}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0" Foreground="#15803D"/></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="진료 대기" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="접수 순서 · 최대 6명 · 30분 이상 대기 강조" FontSize="11" Foreground="#64748B" Margin="0,6,0,12"/>
                    <DataGrid ItemsSource="{Binding WaitingPatients}"><DataGrid.Columns>
                        <DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="담당의" Binding="{Binding DoctorName}" Width="*"/>
                        <DataGridTextColumn Header="대기" Binding="{Binding WaitingTime}" Width="65">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsLongWait}" Value="True"><Setter Property="Foreground" Value="#B45309"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns></DataGrid>
                    <TextBlock Text="대기 중인 환자가 없습니다."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Empty}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasData}" Value="True"/><Condition Binding="{Binding WaitingPatients.Count}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <Button Content="진료 관리 →" Command="{Binding NavigateCommand}" CommandParameter="encounters" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="다가오는 예약" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="오늘 미접수 예약 · 시간 경과 포함 · 최대 6건" FontSize="11" Foreground="#64748B" Margin="0,6,0,12"/>
                    <DataGrid ItemsSource="{Binding UpcomingAppointments}"><DataGrid.Columns>
                        <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="48"/>
                        <DataGridTextColumn Header="환자" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="담당의" Binding="{Binding DoctorName}" Width="*"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="65">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#B45309"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns></DataGrid>
                    <TextBlock Text="미접수 예약이 없습니다."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Empty}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasData}" Value="True"/><Condition Binding="{Binding UpcomingAppointments.Count}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <Button Content="예약 관리 →" Command="{Binding NavigateCommand}" CommandParameter="appointments" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="의사별 현황" FontSize="18" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding DoctorSummaries}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="#F1F5F9" CornerRadius="6" Padding="14,10" Margin="0,0,10,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="현재 대기 또는 진료 중인 환자가 없습니다."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Empty}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasData}" Value="True"/><Condition Binding="{Binding DoctorSummaries.Count}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel></Border>
            <WrapPanel Margin="0,18,0,0"><Button Content="외래 접수" Command="{Binding NavigateCommand}" CommandParameter="patients" Background="#1E293B" Foreground="White" Margin="0,0,8,0"/><Button Content="예약 등록" Command="{Binding NavigateCommand}" CommandParameter="newBooking"/></WrapPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,14,0,4" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
